#version 450
// Copies one 16-byte element per invocation.
layout(local_size_x = 128) in;
layout(std430, set = 0, binding = 0) readonly buffer In { uvec4 a[]; } src;
layout(std430, set = 0, binding = 1) writeonly buffer Out { uvec4 b[]; } dst;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    dst.b[i] = src.a[i];
}
